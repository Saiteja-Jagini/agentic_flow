# Required for automatic website discovery + AI test planning.
OPENAI_API_KEY=
# Use a model available to your API account. Legacy gpt-4 is supported.
OPENAI_MODEL=gpt-4
TARGET_BASE_URL=http://127.0.0.1:3000

# Optional: existing website test account for protected pages.
TARGET_LOGIN_PATH=/login
TARGET_VALID_EMAIL=
TARGET_VALID_PASSWORD=

# Failure evaluation is local by default; Jev is not required for website mode.
AGENT_EVALUATOR=local
JEV_API_KEY=
JEV_MODEL=jev-latest

# Only used by the older `npm run test:login` template.
TARGET_INVALID_PASSWORD=deliberately-incorrect-password
TARGET_EMAIL_LABEL=Email
TARGET_PASSWORD_LABEL=Password
TARGET_SUBMIT_NAME=Login
TARGET_SUCCESS_PATH=/dashboard
TARGET_INVALID_MESSAGE=Invalid credentials
